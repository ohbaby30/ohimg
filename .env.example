# Fill your final origin. No trailing path.
APP_URL=https://img.example.com
# Generate with: openssl rand -hex 32
# Keep this secret unchanged during updates. Needed to decrypt SMTP and Telegram settings.
APP_SECRET=
# Same-host proxy: loopback. Remote NPM: use this server's private/VPN IP,
# or 0.0.0.0 with ingress restricted to the NPM egress IP before exposing it.
BIND_IP=127.0.0.1
HOST_PORT=18080
# Only trusted reverse proxy IPs or CIDRs. Empty by default.
TRUST_PROXY=

# For new deployments. Existing installations MUST keep their original name.
# Keep it unchanged so updates reuse the same local volumes.
COMPOSE_PROJECT_NAME=ohimg
# For SAME-HOST container NPM only, after confirming its network name:
# Do not set these for NPM on another server.
# COMPOSE_FILE=compose.yml:compose.npm.yml
# NPM_NETWORK=your_existing_npm_network
